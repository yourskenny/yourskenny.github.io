{
  "name": "yourskenny.github.io",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "dev:faust": "astro dev --host 127.0.0.1 --port 4321",
    "serve:faust": "node scripts/faust-gateway.mjs",
    "build": "astro build",
    "preview": "astro preview",
    "content:from-folder": "node scripts/content-from-folder.mjs",
    "test:site": "node tests/check-site.mjs",
    "test:content": "node tests/content-from-folder.test.mjs",
    "test:faust": "node --test tests/faust-protocol.test.mjs",
    "test": "npm run test:site && npm run test:content && npm run test:faust",
    "deploy": "npm run build && node scripts/deploy-pages.mjs"
  },
  "dependencies": {
    "@astrojs/mdx": "^5.0.4",
    "astro": "^6.1.9"
  }
}
