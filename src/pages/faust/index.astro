---
import BaseLayout from "../../layouts/BaseLayout.astro";
const nativeUrl = "https://desktop-9v90afb.tail40a158.ts.net/dsh/";
---

<BaseLayout title="浮士德 · yourskenny" description="进入浮士德的原生 DSH 工作空间。" noindex={true}>
  <section class="native-entry">
    <p class="eyebrow">FAUST / NATIVE DSH</p>
    <h1>浮士德 <em>Faust</em></h1>
    <p class="intro">正在打开原生 DSH 工作空间。</p>
    <p>继续使用原生会话、模型、工具与任务界面。</p>
    <a class="enter" href={nativeUrl} id="native-entry-link">进入原生 DSH ↗</a>
    <p class="hint">首次进入需输入现有的所有者口令，主机需要保持在线。</p>
    <a class="manage" href="https://desktop-9v90afb.tail40a158.ts.net/dsh-access/">管理远程登录</a>
    <noscript><p>点击上方按钮即可打开，原生 DSH 页面需要启用 JavaScript。</p></noscript>
  </section>
  <script>
    const link = document.getElementById("native-entry-link");
    if (link instanceof HTMLAnchorElement) window.location.replace(link.href);
  </script>
</BaseLayout>

<style>
  .native-entry{max-width:680px;margin:10vh auto;padding:32px 24px 80px}
  .eyebrow{font-size:11px;letter-spacing:.16em;color:var(--accent);font-weight:700}
  h1{font-size:44px;letter-spacing:-.03em;margin:20px 0 24px}
  h1 em{font:italic 34px Georgia,serif;color:var(--muted);margin-left:14px}
  .intro{font-size:20px;color:var(--text)}
  p{line-height:1.9;color:var(--muted)}
  .enter{display:inline-block;background:var(--accent);color:var(--surface);padding:13px 24px;border-radius:8px;text-decoration:none;margin:24px 0 12px}
  .hint,.manage{font-size:13px}
  a:focus-visible{outline:3px solid var(--accent);outline-offset:4px}
</style>
